{{ 'section-scrolling-marquee.css' | asset_url | stylesheet_tag }}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div
    class="scrolling-marquee scrolling-marquee--{{ section.settings.text_size }}{% if section.settings.uppercase %} scrolling-marquee--uppercase{% endif %}"
    style="--marquee-duration: {{ section.settings.speed }}s; padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px;"
  >
    <div class="scrolling-marquee__track">
      {%- for copy in (1..4) -%}
        <div class="scrolling-marquee__content"{% if copy > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <span class="scrolling-marquee__item" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
            <span class="scrolling-marquee__sep" aria-hidden="true">{{ section.settings.separator | default: '•' }}</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Scrolling ribbon",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Speed (seconds per loop)",
      "info": "Smaller number = faster ribbon.",
      "default": 25
    },
    {
      "type": "select",
      "id": "text_size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium",
      "label": "Text size"
    },
    {
      "type": "checkbox",
      "id": "uppercase",
      "label": "Uppercase letters",
      "default": true
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator character",
      "default": "•"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-4"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "phrase",
      "name": "Phrase",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Handmade in small batches"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling ribbon",
      "blocks": [
        { "type": "phrase", "settings": { "text": "Handmade in small batches" } },
        { "type": "phrase", "settings": { "text": "100% natural ingredients" } },
        { "type": "phrase", "settings": { "text": "Gentle on skin" } },
        { "type": "phrase", "settings": { "text": "Plant-based & palm-free" } }
      ]
    }
  ]
}
{% endschema %}
